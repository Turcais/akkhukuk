# ─────────────────────────────────────────────────────────────
# SITE
# Vercel'de projenin yayin adresi. Sonunda "/" olmamalı.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.akkhukuk.com.tr

# ─────────────────────────────────────────────────────────────
# SANITY — yönetim paneli ve içerik
# https://sanity.io üzerinden ücretsiz proje açıp buraya yazın
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# İletişim formu mesajlarının panele kaydedilmesi için gerekli.
# Sanity → Project → API → Tokens → "Editor" yetkisiyle üretin.
SANITY_API_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────
# RESEND — iletişim formu bildirim e-postası
# https://resend.com üzerinden hesap açın
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=

# Gönderen adresi. Resend'de alan adı doğrulanana kadar
# "AKK Hukuk <onboarding@resend.dev>" kullanabilirsiniz.
CONTACT_FROM="AKK Hukuk <bildirim@akkhukuk.com.tr>"

# Başvuruların düşeceği adres
CONTACT_TO=info@akkhukuk.com.tr
